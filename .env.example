# LLM 配置（复制为 .env，然后 npm run start:env）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 可选
# LLM_TEMPERATURE=0.8
# LLM_MAX_TOKENS=8000
# LLM_TIMEOUT_MS=120000
# LLM_MAX_REPAIRS=1
# LLM_JSON_MODE=1
# 紧凑计划：1 让模型使用短字段名/palette 索引（默认），0 使用完整字段名
# LLM_COMPACT_PLAN=1
# LLM_EXTRA_BODY={"reasoning_effort":"low"}
# 显式推理档位：优先级高于 LLM_EXTRA_BODY，避免外部同名环境变量覆盖 .env
# LLM_REASONING_EFFORT=none
# LLM_DISABLE=1
# 构图日志：0 关闭，full 额外打印完整计划 JSON
# LMBRUSH_LOG_PLAN=full

# 成本估算（可选）：美元 / 百万 token。填了才会在页面信息里显示 ≈$。
# LLM_PRICE_INPUT=0.15
# LLM_PRICE_OUTPUT=0.60
# 视觉评审使用不同模型时单独填写；留空沿用 LLM_PRICE_*
# VISION_PRICE_INPUT=0.15
# VISION_PRICE_OUTPUT=0.60

# 视觉评审 / 参考图解析 / 混合重构 / 纯 LLM 重构（可选，需要支持 image_url 的多模态模型）
# 不填 VISION_MODEL 时视觉评审、参考图视觉解析和参考重构都不启用；
# 忠实复刻仍可完全本地运行（像素导引，不经过 LLM 计划）。
# VISION_BASE_URL / VISION_API_KEY 默认沿用 LLM_*
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MIN_SCORE=75
# VISION_MAX_REPAIRS=1
# 视觉评审推理档位；默认沿用 LLM_REASONING_EFFORT
# 取值取决于服务商：部分模型只接受 none/low/medium/high/max（minimal 会 400）
# VISION_REASONING_EFFORT=none
# VISION_MAX_TOKENS=8000
# VISION_TIMEOUT_MS=90000
# VISION_REPAIR_TIMEOUT_MS=120000
# VISION_IMAGE_SIZE=384
# VISION_DISABLE=1

# 公开演示口令（可选）
# 设置后所有 POST /api/* 需要口令；留空则完全公开。浏览器用
# <站点>/api/login?token=<口令> 打开一次，写入 30 天 HttpOnly Cookie。
# 脚本也可发送 Authorization: Bearer <口令> 或 x-demo-token: <口令>。
# DEMO_TOKEN=

# 隐藏模型名（可选）：Vercel 部署默认隐藏（运行时检测 VERCEL=1）；
# HIDE_MODEL=1 在任意环境强制隐藏，HIDE_MODEL=0 在 Vercel 上也显示。
# 隐藏时 API 响应里的 model 字段为 null，字符串中的模型 ID 替换为 hidden。
# HIDE_MODEL=1